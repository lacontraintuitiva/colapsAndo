# Variables de entorno para desarrollo local
# Copia este archivo a .env y ajusta los valores según tu configuración

# Configuración de la base de datos
DATABASE_URL=postgresql://username:password@localhost:5432/colapsando

# Configuración de Flask
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=tu_clave_secreta_aqui

# Configuración de reCAPTCHA
RECAPTCHA_SITE_KEY=tu_recaptcha_site_key
RECAPTCHA_SECRET_KEY=tu_recaptcha_secret_key

# Configuración de correo electrónico
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=tu_email@gmail.com
MAIL_PASSWORD=tu_app_password
MAIL_DEFAULT_SENDER=tu_email@gmail.com

# Configuración de uploads
UPLOAD_FOLDER=uploads
MAX_CONTENT_LENGTH=16777216

# Configuración de desarrollo
DEBUG=True
TESTING=False